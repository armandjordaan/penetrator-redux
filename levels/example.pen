# Kill the dish first and every missile after it flies unguided.
spawn radar 280
spawn silo 420
spawn silo 560
spawn mine 660 150
spawn turret 700
spawn silo 800

# The objective, at the back of the chamber. Bombs only - cannon fire will not
# scratch it.
spawn warhead 1088.0
end
